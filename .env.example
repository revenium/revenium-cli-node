# Configuration for the scripts under examples/, which load this file via `dotenv/config`.
# The installed CLIs do NOT read this file: each tool keeps its own configuration,
# written by `<bin> setup`. See "Configuration File Locations" in the README.

REVENIUM_API_KEY=hak_your_revenium_api_key
REVENIUM_ENDPOINT=https://api.revenium.ai

# Corporate network (optional)
HTTPS_PROXY=http://proxy.corp.example:8080
HTTP_PROXY=http://proxy.corp.example:8080
NO_PROXY=localhost,127.0.0.1
NODE_EXTRA_CA_CERTS=/etc/ssl/corp-ca.pem
